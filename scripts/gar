#!/usr/bin/env python3
# PYTHON_ARGCOMPLETE_OK
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
VENV = ROOT / ".venv"
VENV_PYTHON = VENV / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
GAR_REQUIREMENTS = ROOT / "requirements-gar.txt"

REQUIRED_IMPORTS = ("argcomplete", "serial", "psutil")


def ensure_venv() -> int:
    if not VENV_PYTHON.exists():
        result = subprocess.run([sys.executable, "-m", "venv", str(VENV)], check=False)
        if result.returncode != 0 or not VENV_PYTHON.exists():
            print(
                "python3 -m venv が pip 付き venv を作成できませんでした。"
                " python3-venv を導入して make init を再実行してください。",
                file=sys.stderr,
            )
            return result.returncode or 1

    pip_check = subprocess.run(
        [str(VENV_PYTHON), "-m", "pip", "--version"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if pip_check.returncode != 0:
        print(
            ".venv に pip がありません。rm -rf .venv 後、python3-venv を導入して make init を再実行してください。",
            file=sys.stderr,
        )
        return pip_check.returncode or 1

    dependency_check = subprocess.run(
        [
            str(VENV_PYTHON),
            "-c",
            "; ".join(f"import {module}" for module in REQUIRED_IMPORTS),
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if dependency_check.returncode != 0:
        result = subprocess.run(
            [str(VENV_PYTHON), "-m", "pip", "install", "-r", str(GAR_REQUIREMENTS)],
            check=False,
        )
        if result.returncode != 0:
            return result.returncode

    return 0


# Bootstrapの処理概要:
# - gar.cmdまたはこのscriptは、最初はsystem Pythonや別Projectのvenvで起動され得る。
# - このrepositoryの.venvが有効でなければ、ensure_venv()でPythonとruntime依存を
#   準備し、元のCLI引数を保ったまま、そのPythonで同じscriptを一度だけ再実行する。
# - 再実行した子processには再帰防止用のGAR_VENVを設定する。手動でrepositoryの
#   venvをactivate済みならVIRTUAL_ENVが一致するため、再実行せずCLI処理へ進む。
# - 引数がsetupだけなら、bootstrap完了後にlauncher自身が消費して正常終了する。
#   workspaceやenvironmentの設定はGAR CLIのconfig commandが担当する。対話実行では
#   scripts directoryのPATH登録を確認し、登録済みなら変更せずSKIPする。
def main() -> int:
    if os.environ.get("GAR_VENV") != str(VENV) and os.environ.get("VIRTUAL_ENV") != str(VENV):
        result = ensure_venv()
        if result != 0:
            return result

        env = os.environ.copy()
        env["GAR_VENV"] = str(VENV)
        return subprocess.run([str(VENV_PYTHON), __file__, *sys.argv[1:]], env=env).returncode

    if sys.argv[1:] == ["setup"]:
        # A manually activated repository venv bypasses the relaunch above, so
        # explicitly verify/install its runtime dependencies for setup.
        if os.environ.get("GAR_VENV") != str(VENV):
            result = ensure_venv()
            if result != 0:
                return result
        print(f"GAR runtimeの準備が完了しました: {VENV}")
        sys.path.insert(0, str(ROOT))
        from scripts.gar_lib.launcher_setup import offer_scripts_path_registration

        return offer_scripts_path_registration(ROOT / "scripts")

    sys.path.insert(0, str(ROOT))

    from scripts.gar_lib.cli import main as cli_main

    return cli_main()


if __name__ == "__main__":
    raise SystemExit(main())
